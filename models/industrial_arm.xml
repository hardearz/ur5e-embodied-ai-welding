<mujoco model="industrial_6dof_arm">
  <compiler angle="radian" coordinate="local" meshdir="assets" autolimits="true"/>
  
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="640" offheight="480"/>
    <quality shadowsize="2048"/>
  </visual>

  <default>
    <joint damping="1.0" armature="0.1"/>
    <geom friction="1.0 0.005 0.0001"/>
    <motor ctrlrange="-100 100"/>
    <position kp="150" kv="15"/>
  </default>

  <worldbody>
    <!-- Lighting -->
    <light diffuse="0.8 0.8 0.8" pos="0 0 3.5" dir="0 0 -1" castshadow="true"/>
    <light diffuse="0.3 0.3 0.3" pos="1.5 -1.5 2.0" dir="-1 1 -1"/>

    <!-- Floor and Workspace Table -->
    <geom name="floor" type="plane" size="3 3 0.1" rgba="0.25 0.25 0.28 1"/>
    <geom name="table" type="box" pos="0.5 0 0.4" size="0.45 0.6 0.4" rgba="0.75 0.75 0.75 1"/>
    
    <!-- Industrial Workpiece (Plate with target welding seam) -->
    <body name="workpiece" pos="0.55 0 0.81">
      <geom name="plate" type="box" size="0.15 0.25 0.01" rgba="0.3 0.35 0.4 1"/>
      <!-- Visual indicator of the seam -->
      <geom name="seam_line" type="capsule" pos="0 0 0.012" size="0.004 0.18" euler="1.5708 0 0" rgba="0.9 0.6 0.1 1"/>
    </body>

    <!-- Third-person Workspace Overview Camera -->
    <camera name="workspace_cam" pos="1.4 -0.9 1.5" xyaxes="0.6 0.8 0 -0.4 0.3 0.86"/>

    <!-- 6-DOF Robot Base -->
    <body name="base_link" pos="0 0 0.8">
      <geom name="base_geom" type="cylinder" size="0.1 0.05" rgba="0.2 0.2 0.22 1"/>

      <!-- Joint 1: Base Yaw (Rotation about Z) -->
      <body name="link1" pos="0 0 0.05">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
        <geom type="cylinder" size="0.08 0.08" pos="0 0 0.08" rgba="0.85 0.35 0.1 1"/>

        <!-- Joint 2: Shoulder Pitch (Rotation about Y) -->
        <body name="link2" pos="0 0 0.16">
          <joint name="joint2" type="hinge" axis="0 1 0" range="-2.09 2.09"/>
          <geom type="cylinder" size="0.06 0.18" pos="0 0 0.18" euler="0 0 0" rgba="0.9 0.9 0.92 1"/>

          <!-- Joint 3: Elbow Pitch (Rotation about Y) -->
          <body name="link3" pos="0 0 0.36">
            <joint name="joint3" type="hinge" axis="0 1 0" range="-2.61 2.61"/>
            <geom type="cylinder" size="0.05 0.16" pos="0 0 0.16" rgba="0.85 0.35 0.1 1"/>

            <!-- Joint 4: Wrist 1 Pitch (Rotation about Y) -->
            <body name="link4" pos="0 0 0.32">
              <joint name="joint4" type="hinge" axis="0 1 0" range="-3.14 3.14"/>
              <geom type="cylinder" size="0.045 0.06" pos="0 0 0.06" rgba="0.9 0.9 0.92 1"/>

              <!-- Joint 5: Wrist 2 Yaw (Rotation about Z) -->
              <body name="link5" pos="0 0 0.12">
                <joint name="joint5" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
                <geom type="cylinder" size="0.04 0.05" pos="0 0 0.05" rgba="0.85 0.35 0.1 1"/>

                <!-- Joint 6: Wrist 3 Roll (Rotation about local tool axis Z) -->
                <body name="link6" pos="0 0 0.10">
                  <joint name="joint6" type="hinge" axis="0 0 1" range="-6.28 6.28"/>
                  <geom type="cylinder" size="0.035 0.03" pos="0 0 0.03" rgba="0.2 0.2 0.22 1"/>

                  <!-- End-Effector Tool Assembly (Industrial Torch / Tool) -->
                  <body name="ee_tool" pos="0 0 0.06">
                    <geom type="cylinder" size="0.015 0.04" pos="0 0 0.04" rgba="0.3 0.3 0.35 1"/>
                    <geom type="cylinder" size="0.008 0.02" pos="0 0 0.09" rgba="0.95 0.7 0.1 1"/>

                    <!-- Tool-Center-Point (TCP) Site -->
                    <site name="tcp" pos="0 0 0.11" size="0.008" rgba="1 0 0 1"/>

                    <!-- Eye-in-Hand Wrist Camera looking directly down along the tool axis -->
                    <camera name="wrist_cam" pos="0.04 0 0.02" xyaxes="0 1 0 -1 0 0"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="act_j1" joint="joint1" kp="250" kv="25" ctrlrange="-3.14 3.14"/>
    <position name="act_j2" joint="joint2" kp="250" kv="25" ctrlrange="-2.09 2.09"/>
    <position name="act_j3" joint="joint3" kp="200" kv="20" ctrlrange="-2.61 2.61"/>
    <position name="act_j4" joint="joint4" kp="150" kv="15" ctrlrange="-3.14 3.14"/>
    <position name="act_j5" joint="joint5" kp="100" kv="10" ctrlrange="-3.14 3.14"/>
    <position name="act_j6" joint="joint6" kp="80"  kv="8"  ctrlrange="-6.28 6.28"/>
  </actuator>
</mujoco>
