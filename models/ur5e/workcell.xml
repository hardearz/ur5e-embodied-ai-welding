<mujoco model="ur5e_industrial_workcell">
  <include file="ur5e.xml"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.2 0.2 0.2" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global offwidth="640" offheight="480" azimuth="135" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.05 0.05 0.08" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.22 0.25" rgb2="0.15 0.17 0.20"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <!-- Floor & Lighting -->
    <light pos="0 0 2.5" dir="0 0 -1" diffuse="0.8 0.8 0.8" castshadow="true"/>
    <light pos="1.2 -1.2 1.8" dir="-1 1 -1" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" size="3 3 0.05" type="plane" material="groundplane"/>

    <!-- Workstation Table: 1.0m long x 1.0m wide x 0.4m high (top surface at z=0.4m) -->
    <geom name="table" type="box" pos="0.3 0 0.2" size="0.5 0.5 0.2" rgba="0.22 0.22 0.25 1"/>

    <!-- Industrial Workpiece: Steel Plate with Seam Line on the table -->
    <body name="workpiece" pos="0.52 0 0.41">
      <geom name="plate" type="box" size="0.12 0.22 0.01" rgba="0.35 0.38 0.42 1"/>
      <geom name="seam_line" type="capsule" pos="0 0 0.012" size="0.003 0.16" euler="1.5708 0 0" rgba="0.95 0.65 0.1 1"/>
    </body>

    <!-- Overview Camera: Third-person Workspace View -->
    <camera name="workspace_cam" pos="1.45 -0.95 1.25" xyaxes="0.65 0.76 0 -0.32 0.27 0.91"/>
  </worldbody>
</mujoco>
